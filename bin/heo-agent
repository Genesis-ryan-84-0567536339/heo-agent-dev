#!/usr/bin/env bash
# ==============================================================================
# HEO-AGENT: Lệnh điều hành toàn hệ thống cho Heo-Agent (Bé Heo)
# Hỗ trợ cả 2 tên gọi: heo-agent và heo-zalo
# Tiêu chuẩn hóa 100% trên Docker Engine & Docker Compose v2
# ==============================================================================
set -e

CMD_NAME="$(basename "$0")"
if [ "$CMD_NAME" != "heo-agent" ] && [ "$CMD_NAME" != "heo-zalo" ]; then
    CMD_NAME="heo-agent"
fi

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

get_docker_compose() {
    if docker compose version &> /dev/null 2>&1; then
        echo "docker compose"
    elif sudo docker compose version &> /dev/null 2>&1; then
        echo "sudo docker compose"
    elif command -v docker-compose &> /dev/null; then
        echo "docker-compose"
    elif sudo command -v docker-compose &> /dev/null; then
        echo "sudo docker-compose"
    else
        echo "docker compose"
    fi
}

DOCKER_COMPOSE="$(get_docker_compose)"

open_web_ui() {
    local url="http://localhost:5066"
    local lock="/tmp/.heo_agent_web_open.lock"
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    if [ -f "$lock" ]; then
        local last
        last=$(cat "$lock" 2>/dev/null || echo 0)
        if [ $((now - last)) -lt 4 ]; then
            return 0
        fi
    fi
    echo "$now" > "$lock" 2>/dev/null || true

    for i in {1..15}; do
        if curl -s -m 1 "$url" >/dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v xdg-open &>/dev/null; then
            xdg-open "$url" >/dev/null 2>&1 &
        elif command -v google-chrome &>/dev/null; then
            google-chrome "$url" >/dev/null 2>&1 &
        elif command -v firefox &>/dev/null; then
            firefox "$url" >/dev/null 2>&1 &
        elif command -v gio &>/dev/null; then
            gio open "$url" >/dev/null 2>&1 &
        fi
    elif command -v wslview &>/dev/null; then
        wslview "$url" >/dev/null 2>&1 &
    elif command -v open &>/dev/null; then
        open "$url" >/dev/null 2>&1 &
    fi
}

case "${1:-}" in
    stop)
        echo "🛑 Đang dừng Heo-Agent (Bé Heo)..."
        "$PROJECT_DIR/stop.sh"
        ;;
    restart)
        echo "🔄 Đang khởi động lại Heo-Agent (Bé Heo)..."
        "$PROJECT_DIR/stop.sh"
        sleep 1
        "$PROJECT_DIR/start.sh" daemon
        ;;
    status)
        echo "📊 Kiểm tra trạng thái Heo-Agent (Bé Heo):"
        if [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
            $DOCKER_COMPOSE ps 2>/dev/null || true
        fi
        curl -s http://127.0.0.1:5066/api/status | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print('🤖 Mô hình AI:', d.get('active_model'), f'({str(d.get(\"effort\", \"medium\")).upper()})')
    print('📱 Zalo:', 'Đã đăng nhập (UID: ' + str(d.get('zalo', {}).get('user_id', 'N/A')) + ')' if d.get('zalo', {}).get('logged_in') else 'Chưa đăng nhập')
    g = d.get('google', {})
    if g.get('authenticated'):
        print('🔐 Google AGY:', g.get('email', 'Đã xác thực'), f\"[{g.get('tier_name', 'Free Tier')}]\")
    else:
        print('🔐 Google AGY: Chưa đăng nhập')
    print('🌐 Web Dashboard:', 'http://localhost:5066')
except Exception:
    pass
" 2>/dev/null || true
        ;;
    logs)
        echo "📜 Đang theo dõi nhật ký Heo-Agent (Ctrl+C để thoát)..."
        if [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
            $DOCKER_COMPOSE logs -f --tail 50
        elif [ -d "$PROJECT_DIR/logs" ]; then
            tail -n 30 -f "$PROJECT_DIR/logs/zalo.log" "$PROJECT_DIR/logs/engine.log" 2>/dev/null || true
        else
            echo "Chưa có nhật ký hoạt động."
        fi
        ;;
    tui)
        "$PROJECT_DIR/start.sh" --tui
        ;;
    --bg|daemon)
        echo "🚀 Đang khởi chạy Heo-Agent (Bé Heo) chế độ nền (Daemon 24/7)..."
        "$PROJECT_DIR/start.sh" daemon
        ;;
    web)
        echo "🌐 BẢNG ĐIỀU KHIỂN QUẢN TRỊ WEB UI:"
        echo "   👉 http://localhost:5066"
        echo "   (Hoặc http://<IP_MAY_CHU>:5066)"
        open_web_ui
        ;;
    model)
        TARGET="${2:-}"
        if [ -n "$TARGET" ]; then
            curl -s -X POST http://127.0.0.1:5066/api/switch_model \
                -H "Content-Type: application/json" \
                -d "{\"model\": \"$TARGET\"}" | python3 -c "import sys, json; d=json.load(sys.stdin); print('✔ Đã chuyển sang mô hình:', d.get('active_model')) if d.get('ok') else print('❌ Lỗi:', d.get('error'))"
        else
            curl -s http://127.0.0.1:5066/api/status | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print('🤖 Mô hình hiện tại:', d.get('active_model'))
    print('⚡ Mức suy luận (Effort):', str(d.get('effort')).upper())
    print('\n💡 Danh sách mô hình hỗ trợ:')
    for m in d.get('supported_models', []):
        print(f'   • {m[\"name\"]} - {m.get(\"desc\", \"\")}')
    print(f'\n👉 Cú pháp đổi: {sys.argv[1] if len(sys.argv)>1 else \"heo-agent\"} model <flash|pro|sonnet|opus|oss>')
except Exception as e:
    print(f'Máy chủ chưa chạy. Hãy gõ: {sys.argv[1] if len(sys.argv)>1 else \"heo-agent\"} --bg')
" "$CMD_NAME"
        fi
        ;;
    effort)
        LEVEL="${2:-}"
        if [ -n "$LEVEL" ]; then
            curl -s -X POST http://127.0.0.1:5066/api/set_effort \
                -H "Content-Type: application/json" \
                -d "{\"effort\": \"$LEVEL\"}" | python3 -c "import sys, json; d=json.load(sys.stdin); print('✔ Đã chỉnh mức suy luận:', d.get('effort', '').upper(), f'({d.get(\"active_model\", \"\")})') if d.get('ok') else print('❌ Lỗi:', d.get('error'))"
        else
            echo "👉 Cú pháp: $CMD_NAME effort <low|medium|high>"
        fi
        ;;
    login-google)
        echo "⚡ KHỞI CHẠY XÁC THỰC GOOGLE CHO AGY CLI..."
        HOST_TOKEN=""
        if command -v secret-tool >/dev/null 2>&1; then
            HOST_TOKEN=$(secret-tool lookup service gemini username antigravity 2>/dev/null || true)
        fi
        if [ -n "$HOST_TOKEN" ]; then
            mkdir -p "$PROJECT_DIR/auth/home/.gemini/antigravity-cli"
            echo "$HOST_TOKEN" > "$PROJECT_DIR/auth/home/.gemini/antigravity-cli/antigravity-oauth-token"
            echo "✔ Đã tự động đồng bộ phiên đăng nhập Google từ máy chủ vào Heo-Agent!"
            curl -s -X POST http://127.0.0.1:5066/api/check_quota >/dev/null 2>&1 || true
        else
            echo "🌐 Đang mở Web UI để đăng nhập Google OAuth:"
            echo "   👉 http://localhost:5066"
            open_web_ui
        fi
        ;;
    logout-google)
        echo "🛑 Đang đăng xuất tài khoản Google..."
        curl -s -X POST http://127.0.0.1:5066/api/logout_google 2>/dev/null || true
        rm -rf "$PROJECT_DIR/auth/home/.gemini"
        echo "✔ Đã xóa phiên đăng nhập Google. Để đăng nhập tài khoản khác: $CMD_NAME login-google"
        ;;
    login-zalo)
        echo "📱 KHỞI CHẠY QUÉT MÃ QR ĐĂNG NHẬP ZALO..."
        rm -f "$PROJECT_DIR/data/zalo_session.json"
        $DOCKER_COMPOSE run --rm -it app node /app/bridge/bot.js --qr-only
        echo "✔ Đã lưu phiên Zalo mới! Khởi động lại dịch vụ bằng: $CMD_NAME restart"
        ;;
    logout-zalo)
        echo "🛑 Đang đăng xuất tài khoản Zalo..."
        curl -s -X POST http://127.0.0.1:5066/api/logout_zalo -H "X-Local-Admin: 1" 2>/dev/null || true
        docker exec heo-agent-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || podman exec heo-agent-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || docker exec zalo-agy-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || podman exec zalo-agy-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || true
        rm -f "$PROJECT_DIR/data/zalo_session.json"
        rm -f "$PROJECT_DIR/data/zalo_profile.json"
        rm -f "$PROJECT_DIR/data/zalo_qr.png"
        rm -f "$PROJECT_DIR/data/zalo_qr_info.json"
        rm -f "$PROJECT_DIR/workspace/zalo_qr.png"
        echo "✔ Đã xóa phiên đăng nhập Zalo. Để đăng nhập tài khoản khác: $CMD_NAME login-zalo"
        ;;
    doctor|check|heal|repair)
        shift
        "$PROJECT_DIR/doctor.sh" "$@"
        ;;
    help|--help|-h)
        echo "🐷 HEO-AGENT (BÉ HEO) — BỘ LỆNH ĐIỀU HÀNH TOÀN HỆ THỐNG:"
        echo "   👉 $CMD_NAME               : Mở Web Dashboard & Kiểm tra trạng thái trực tiếp"
        echo "   👉 $CMD_NAME doctor        : Chẩn đoán sức khỏe hệ thống toàn diện"
        echo "   👉 $CMD_NAME doctor --fix  : Tự động sửa chữa & phục hồi khi hệ thống bị lỗi"
        echo "   👉 $CMD_NAME web           : Mở Web Console quản trị (cổng 5066)"
        echo "   👉 $CMD_NAME --bg          : Khởi chạy chế độ nền (Daemon trực chiến 24/7)"
        echo "   👉 $CMD_NAME status        : Kiểm tra trạng thái chi tiết (Model, Zalo, Google AGY)"
        echo "   👉 $CMD_NAME model         : Xem và chuyển đổi mô hình AI (flash, pro, sonnet, opus)"
        echo "   👉 $CMD_NAME effort        : Điều chỉnh mức suy luận logic (low, medium, high)"
        echo "   👉 $CMD_NAME logs          : Theo dõi luồng nhật ký hoạt động thời gian thực"
        echo "   👉 $CMD_NAME restart       : Khởi động lại toàn bộ hệ thống"
        echo "   👉 $CMD_NAME stop          : Dừng hệ thống an toàn"
        echo "   👉 $CMD_NAME login-zalo    : Quét mã QR đăng nhập tài khoản Zalo"
        echo "   👉 $CMD_NAME logout-zalo   : Đăng xuất tài khoản Zalo"
        echo "   👉 $CMD_NAME login-google  : Đăng nhập Google AGY Core Agent"
        echo "   👉 $CMD_NAME logout-google : Đăng xuất tài khoản Google AGY"
        echo "   👉 $CMD_NAME uninstall     : Dọn dẹp & khôi phục cài đặt gốc (Factory Reset)"
        ;;
    uninstall|clean)
        shift
        "$PROJECT_DIR/uninstall.sh" "$@"
        ;;
    *)
        # Mặc định khi gọi lệnh heo-agent / heo-zalo không tham số:
        # Nếu chưa chạy thì tự động khởi chạy daemon; nếu đang chạy thì báo trạng thái và luôn luôn tự mở Web UI
        if curl -s -m 1 http://127.0.0.1:5066/api/status >/dev/null 2>&1; then
            echo "🚀 Heo-Agent (Bé Heo) đang trực chiến 24/7!"
            echo "🌐 Đang tự động mở Web Dashboard tại: http://localhost:5066"
            open_web_ui
            curl -s http://127.0.0.1:5066/api/status | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    cmd = sys.argv[1] if len(sys.argv)>1 else 'heo-agent'
    print('\n🔹 Mô hình AI:', d.get('active_model'))
    print('🔹 Mức suy luận (Effort):', str(d.get('effort', 'medium')).upper())
    print('🔹 Tài khoản Zalo:', 'Đã kết nối (UID: ' + str(d.get('zalo', {}).get('user_id', 'N/A')) + ')' if d.get('zalo', {}).get('logged_in') else 'Chưa đăng nhập')
    print('🔹 Google AGY Auth:', 'Đã xác thực' if d.get('google', {}).get('authenticated') else 'Chưa xác thực')
    print('🔹 Sếp nhận diện:', d.get('config', {}).get('boss_name', 'Sếp'))
    print('\n💡 Tiện ích nhanh:')
    print(f'   • {cmd} doctor  : Chẩn đoán & tự động sửa chữa phục hồi khi bị lỗi')
    print(f'   • {cmd} logs    : Xem luồng log thời gian thực')
    print(f'   • {cmd} model   : Xem và đổi mô hình AI')
    print(f'   • {cmd} restart : Khởi động lại hệ thống')
    print(f'   • {cmd} stop    : Dừng hệ thống')
except Exception:
    pass
" "$CMD_NAME"
        else
            echo "🚀 Khởi chạy Heo-Agent (Bé Heo)..."
            "$PROJECT_DIR/start.sh" daemon
        fi
        ;;
esac
