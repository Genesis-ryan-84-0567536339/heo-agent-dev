#!/usr/bin/env bash
# ==============================================================================
# HEO-AGENT: Lệnh điều hành toàn hệ thống cho Heo-Agent (Bé Heo)
# Hỗ trợ cả 2 tên gọi: heo-agent và heo-zalo
# Tiêu chuẩn hóa 100% trên Docker Engine & Docker Compose v2
# ==============================================================================
set -e

CMD_NAME="$(basename "$0")"
if [ "$CMD_NAME" != "heo-agent" ] && [ "$CMD_NAME" != "heo-zalo" ]; then
    CMD_NAME="heo-agent"
fi

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# ==============================================================================
# AUTO-UPDATE: Tự động cập nhật code mới nhất từ GitHub (chạy ngầm)
# Kiểm tra tối đa 1 lần / 1 giờ để không làm chậm lệnh
# ==============================================================================
_HEO_UPDATE_LOCK="/tmp/.heo_agent_update.lock"
_HEO_UPDATE_LOG="/tmp/.heo_agent_update.log"
_auto_update_bg() {
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    local last=0
    [ -f "$_HEO_UPDATE_LOCK" ] && last=$(cat "$_HEO_UPDATE_LOCK" 2>/dev/null || echo 0)
    # Chỉ check mỗi 3600 giây (1 giờ)
    if [ $((now - last)) -lt 3600 ]; then return 0; fi
    echo "$now" > "$_HEO_UPDATE_LOCK" 2>/dev/null || true

    # Fetch remote silently
    if ! git -C "$PROJECT_DIR" fetch origin main --quiet 2>/dev/null; then return 0; fi

    local LOCAL REMOTE
    LOCAL=$(git -C "$PROJECT_DIR" rev-parse HEAD 2>/dev/null || echo "")
    REMOTE=$(git -C "$PROJECT_DIR" rev-parse origin/main 2>/dev/null || echo "")
    if [ -z "$LOCAL" ] || [ -z "$REMOTE" ] || [ "$LOCAL" = "$REMOTE" ]; then return 0; fi

    # Có update mới → pull
    git -C "$PROJECT_DIR" pull origin main --quiet 2>/dev/null && \
        echo "updated" > "$_HEO_UPDATE_LOG" || true
}

# Chạy update ngầm (không block lệnh chính)
_auto_update_bg &
disown 2>/dev/null || true

# Thông báo nếu vừa có update lần trước
if [ -f "$_HEO_UPDATE_LOG" ] && [ "$(cat "$_HEO_UPDATE_LOG" 2>/dev/null)" = "updated" ]; then
    echo "🔄 Heo-Agent vừa được cập nhật phiên bản mới tự động!" >&2
    rm -f "$_HEO_UPDATE_LOG" 2>/dev/null || true
fi

get_docker_compose() {
    if docker compose version &> /dev/null 2>&1; then
        echo "docker compose"
    elif podman-compose version &> /dev/null 2>&1; then
        echo "podman-compose"
    elif podman compose version &> /dev/null 2>&1; then
        echo "podman compose"
    elif sudo -n docker compose version &> /dev/null 2>&1; then
        echo "sudo docker compose"
    elif command -v docker-compose &> /dev/null; then
        echo "docker-compose"
    elif sudo -n command -v docker-compose &> /dev/null; then
        echo "sudo docker-compose"
    else
        echo "docker compose"
    fi
}

DOCKER_COMPOSE="$(get_docker_compose)"

open_web_ui() {
    local url="http://localhost:5066"
    local lock="/tmp/.heo_agent_web_open.lock"
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    if [ -f "$lock" ]; then
        local last
        last=$(cat "$lock" 2>/dev/null || echo 0)
        if [ $((now - last)) -lt 4 ]; then
            return 0
        fi
    fi
    echo "$now" > "$lock" 2>/dev/null || true

    for i in {1..15}; do
        if curl -s -m 1 "$url" >/dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v xdg-open &>/dev/null; then
            xdg-open "$url" >/dev/null 2>&1 &
        elif command -v google-chrome &>/dev/null; then
            google-chrome "$url" >/dev/null 2>&1 &
        elif command -v firefox &>/dev/null; then
            firefox "$url" >/dev/null 2>&1 &
        elif command -v gio &>/dev/null; then
            gio open "$url" >/dev/null 2>&1 &
        fi
    elif command -v wslview &>/dev/null; then
        wslview "$url" >/dev/null 2>&1 &
    elif command -v open &>/dev/null; then
        open "$url" >/dev/null 2>&1 &
    fi
}

case "${1:-}" in
    update)
        echo "🔄 Đang kiểm tra và cập nhật Heo-Agent..."
        if ! git -C "$PROJECT_DIR" fetch origin main --quiet 2>/dev/null; then
            echo "❌ Không thể kết nối GitHub. Kiểm tra mạng và thử lại."
            exit 1
        fi
        LOCAL=$(git -C "$PROJECT_DIR" rev-parse HEAD 2>/dev/null || echo "")
        REMOTE=$(git -C "$PROJECT_DIR" rev-parse origin/main 2>/dev/null || echo "")
        if [ "$LOCAL" = "$REMOTE" ]; then
            echo "✅ Heo-Agent đang dùng phiên bản mới nhất ($(git -C "$PROJECT_DIR" log -1 --format='%h %s' 2>/dev/null))."
        else
            echo "⬆️  Phát hiện phiên bản mới! Đang cập nhật..."
            git -C "$PROJECT_DIR" pull origin main
            echo ""
            echo "✅ Đã cập nhật thành công!"
            echo "   $(git -C "$PROJECT_DIR" log -1 --format='📝 %h: %s' 2>/dev/null)"
            echo ""
            echo "💡 Restart để áp dụng: heo-agent restart"
        fi
        # Reset lock để auto-update check lại lần sau
        rm -f "$_HEO_UPDATE_LOCK" "$_HEO_UPDATE_LOG" 2>/dev/null || true
        ;;
    stop)
        echo "🛑 Đang dừng Heo-Agent (Bé Heo)..."
        "$PROJECT_DIR/stop.sh"
        ;;
    restart)
        echo "🔄 Đang khởi động lại Heo-Agent (Bé Heo)..."
        "$PROJECT_DIR/stop.sh"
        sleep 1
        "$PROJECT_DIR/start.sh" daemon
        ;;
    status)
        echo "📊 Kiểm tra trạng thái Heo-Agent (Bé Heo):"
        if [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
            $DOCKER_COMPOSE ps 2>/dev/null || true
        fi
        curl -s http://127.0.0.1:5066/api/status | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print('🤖 Mô hình AI:', d.get('active_model'), f'({str(d.get(\"effort\", \"medium\")).upper()})')
    print('📱 Zalo:', 'Đã đăng nhập (UID: ' + str(d.get('zalo', {}).get('user_id', 'N/A')) + ')' if d.get('zalo', {}).get('logged_in') else 'Chưa đăng nhập')
    g = d.get('google', {})
    if g.get('authenticated'):
        print('🔐 Google AGY:', g.get('email', 'Đã xác thực'), f\"[{g.get('tier_name', 'Free Tier')}]\")
    else:
        print('🔐 Google AGY: Chưa đăng nhập')
    print('🌐 Web Dashboard:', 'http://localhost:5066')
except Exception:
    pass
" 2>/dev/null || true
        ;;
    logs)
        echo "📜 Đang theo dõi nhật ký Heo-Agent (Ctrl+C để thoát)..."
        if [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
            $DOCKER_COMPOSE logs -f --tail 50
        elif [ -d "$PROJECT_DIR/logs" ]; then
            tail -n 30 -f "$PROJECT_DIR/logs/zalo.log" "$PROJECT_DIR/logs/engine.log" 2>/dev/null || true
        else
            echo "Chưa có nhật ký hoạt động."
        fi
        ;;
    tui)
        "$PROJECT_DIR/start.sh" --tui
        ;;
    --bg|daemon)
        echo "🚀 Đang khởi chạy Heo-Agent (Bé Heo) chế độ nền (Daemon 24/7)..."
        "$PROJECT_DIR/start.sh" daemon
        ;;
    web)
        echo "🌐 BẢNG ĐIỀU KHIỂN QUẢN TRỊ WEB UI:"
        echo "   👉 http://localhost:5066"
        echo "   (Hoặc http://<IP_MAY_CHU>:5066)"
        open_web_ui
        ;;
    model)
        TARGET="${2:-}"
        if [ -n "$TARGET" ]; then
            curl -s -X POST http://127.0.0.1:5066/api/switch_model \
                -H "Content-Type: application/json" \
                -d "{\"model\": \"$TARGET\"}" | python3 -c "import sys, json; d=json.load(sys.stdin); print('✔ Đã chuyển sang mô hình:', d.get('active_model')) if d.get('ok') else print('❌ Lỗi:', d.get('error'))"
        else
            curl -s http://127.0.0.1:5066/api/status | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print('🤖 Mô hình hiện tại:', d.get('active_model'))
    print('⚡ Mức suy luận (Effort):', str(d.get('effort')).upper())
    print('\n💡 Danh sách mô hình hỗ trợ:')
    for m in d.get('supported_models', []):
        print(f'   • {m[\"name\"]} - {m.get(\"desc\", \"\")}')
    print(f'\n👉 Cú pháp đổi: {sys.argv[1] if len(sys.argv)>1 else \"heo-agent\"} model <flash|pro|sonnet|opus|oss>')
except Exception as e:
    print(f'Máy chủ chưa chạy. Hãy gõ: {sys.argv[1] if len(sys.argv)>1 else \"heo-agent\"} --bg')
" "$CMD_NAME"
        fi
        ;;
    effort)
        LEVEL="${2:-}"
        if [ -n "$LEVEL" ]; then
            curl -s -X POST http://127.0.0.1:5066/api/set_effort \
                -H "Content-Type: application/json" \
                -d "{\"effort\": \"$LEVEL\"}" | python3 -c "import sys, json; d=json.load(sys.stdin); print('✔ Đã chỉnh mức suy luận:', d.get('effort', '').upper(), f'({d.get(\"active_model\", \"\")})') if d.get('ok') else print('❌ Lỗi:', d.get('error'))"
        else
            echo "👉 Cú pháp: $CMD_NAME effort <low|medium|high>"
        fi
        ;;
    login-google)
        echo "⚡ ĐĂNG NHẬP TÀI KHOẢN GOOGLE MỚI CHO AGY CORE AGENT..."
        echo ""
        echo "📌 Trình duyệt sẽ mở trang đăng nhập Google để bạn TỰ CHỌN tài khoản muốn dùng."
        echo "   Bất kỳ tài khoản nào bạn chọn sẽ được lưu riêng cho Heo-Agent."
        echo ""

        # Kiểm tra xem web server 5066 có đang chạy không, nếu chưa thì khởi động daemon
        if ! curl -s -m 1 http://127.0.0.1:5066/api/status >/dev/null 2>&1; then
            echo "🚀 Đang khởi chạy dịch vụ nền Heo-Agent..."
            "$PROJECT_DIR/start.sh" daemon >/dev/null 2>&1 || true
            for _i in {1..10}; do
                if curl -s -m 1 http://127.0.0.1:5066/api/status >/dev/null 2>&1; then
                    break
                fi
                sleep 0.5
            done
        fi

        OAUTH_RESP=$(curl -s http://127.0.0.1:5066/api/oauth_login_url 2>/dev/null || echo "")
        AUTH_URL=$(echo "$OAUTH_RESP" | python3 -c "import sys, json; print(json.load(sys.stdin).get('auth_url', ''))" 2>/dev/null || true)
        SESS_ID=$(echo "$OAUTH_RESP" | python3 -c "import sys, json; print(json.load(sys.stdin).get('session_id', ''))" 2>/dev/null || true)

        if [ -n "$AUTH_URL" ]; then
            echo "🌐 Đang mở trang đăng nhập Google trên trình duyệt..."
            if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
                xdg-open "$AUTH_URL" >/dev/null 2>&1 || true
            fi

            echo ""
            echo "🔗 Nếu trình duyệt không tự mở, hãy copy đường link sau vào trình duyệt:"
            echo -e "\033[36m$AUTH_URL\033[0m"
            echo ""
            echo "👉 Sau khi chọn tài khoản và Cho phép (Allow):"
            echo "   • Trình duyệt sẽ tự động kích hoạt phiên làm việc mới."
            echo "   • Hoặc bạn có thể dán mã Authorization Code / URL chuyển hướng bên dưới:"
            echo ""
            read -t 60 -p "👉 Dán Code/URL (hoặc nhấn Enter để đợi tự động hoàn tất trên trình duyệt): " MANUAL_CODE || true
            echo ""

            if [ -n "$MANUAL_CODE" ]; then
                SUBMIT_RES=$(curl -s -X POST http://127.0.0.1:5066/api/submit_oauth_code \
                    -H "Content-Type: application/json" \
                    -d "{\"code\": \"$MANUAL_CODE\", \"session_id\": \"$SESS_ID\"}" 2>/dev/null || echo "")
                SUCCESS=$(echo "$SUBMIT_RES" | python3 -c "import sys, json; print(json.load(sys.stdin).get('ok', False))" 2>/dev/null || echo "False")
                if [ "$SUCCESS" = "True" ]; then
                    EMAIL=$(echo "$SUBMIT_RES" | python3 -c "import sys, json; print(json.load(sys.stdin).get('google', {}).get('email', ''))" 2>/dev/null || echo "")
                    echo "✔ Đăng nhập Google thành công: $EMAIL!"
                    echo "💡 Chạy '$CMD_NAME status' để xem tài khoản đang dùng."
                    exit 0
                fi
            fi

            echo "⏳ Đang kiểm tra xác thực Google (tối đa 60s)..."
            for _i in {1..30}; do
                STATUS_RES=$(curl -s "http://127.0.0.1:5066/api/oauth_session_status?session_id=$SESS_ID" 2>/dev/null || echo "")
                DONE=$(echo "$STATUS_RES" | python3 -c "import sys, json; print(json.load(sys.stdin).get('done', False))" 2>/dev/null || echo "False")
                if [ "$DONE" = "True" ]; then
                    EMAIL=$(echo "$STATUS_RES" | python3 -c "import sys, json; print(json.load(sys.stdin).get('google', {}).get('email', ''))" 2>/dev/null || echo "")
                    echo ""
                    echo "✔ Đăng nhập Google thành công với tài khoản: $EMAIL!"
                    echo "💡 Chạy '$CMD_NAME status' để xem tài khoản đang dùng."
                    exit 0
                fi
                sleep 2
            done
            echo "⚠️  Hết thời gian chờ. Bạn có thể mở Web Console để đăng nhập trực quan: http://localhost:5066"
        else
            echo "⚠️  Không thể khởi tạo liên kết Google OAuth qua Web Console."
            echo "   Vui lòng mở Web Console: http://localhost:5066 để đăng nhập."
        fi
        ;;
    sync-google)
        echo "⚡ ĐỒNG BỘ PHIÊN GOOGLE CÓ SẴN TỪ MÁY CHỦ..."
        HOST_TOKEN=""
        if command -v secret-tool >/dev/null 2>&1; then
            HOST_TOKEN=$(secret-tool lookup service gemini username antigravity 2>/dev/null || true)
        fi
        if [ -z "$HOST_TOKEN" ] && [ -f "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
            HOST_TOKEN=$(cat "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" 2>/dev/null || true)
        fi
        if [ -n "$HOST_TOKEN" ]; then
            mkdir -p "$PROJECT_DIR/auth/home/.gemini/antigravity-cli"
            echo "$HOST_TOKEN" > "$PROJECT_DIR/auth/home/.gemini/antigravity-cli/antigravity-oauth-token"
            echo "✔ Đã đồng bộ phiên đăng nhập Google hiện tại từ máy chủ vào Heo-Agent."
            curl -s -X POST http://127.0.0.1:5066/api/check_quota >/dev/null 2>&1 || true
            echo "💡 Chạy '$CMD_NAME status' để kiểm tra tài khoản."
        else
            echo "❌ Không có token Google nào trên máy chủ để đồng bộ. Dùng: $CMD_NAME login-google để đăng nhập."
        fi
        ;;
    logout-google)
        echo "🛑 Đang đăng xuất tài khoản Google..."
        curl -s -X POST http://127.0.0.1:5066/api/logout_google 2>/dev/null || true
        rm -rf "$PROJECT_DIR/auth/home/.gemini"
        echo "✔ Đã xóa phiên đăng nhập Google. Để đăng nhập tài khoản khác: $CMD_NAME login-google"
        ;;
    login-zalo)
        echo "📱 KHỞI CHẠY QUÉT MÃ QR ĐĂNG NHẬP ZALO..."
        rm -f "$PROJECT_DIR/data/zalo_session.json"
        # Tự động mở ảnh QR gốc trên Desktop nếu có giao diện đồ họa
        (
            for i in $(seq 1 20); do
                sleep 1
                for qrf in "$PROJECT_DIR/workspace/zalo_qr.png" "$PROJECT_DIR/data/zalo_qr.png"; do
                    if [ -s "$qrf" ]; then
                        if command -v xdg-open >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
                            xdg-open "$qrf" >/dev/null 2>&1 || true
                        fi
                        break 2
                    fi
                done
            done
        ) &
        $DOCKER_COMPOSE run --rm -it app node /app/bridge/bot.js --qr-only
        echo "✔ Đã lưu phiên Zalo mới! Khởi động lại dịch vụ bằng: $CMD_NAME restart"
        ;;
    logout-zalo)
        echo "🛑 Đang đăng xuất tài khoản Zalo..."
        curl -s -X POST http://127.0.0.1:5066/api/logout_zalo -H "X-Local-Admin: 1" 2>/dev/null || true
        docker exec heo-agent-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || podman exec heo-agent-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || docker exec zalo-agy-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || podman exec zalo-agy-copilot pkill -9 -f "node.*bot.js" 2>/dev/null || true
        rm -f "$PROJECT_DIR/data/zalo_session.json"
        rm -f "$PROJECT_DIR/data/zalo_profile.json"
        rm -f "$PROJECT_DIR/data/zalo_qr.png"
        rm -f "$PROJECT_DIR/data/zalo_qr_info.json"
        rm -f "$PROJECT_DIR/workspace/zalo_qr.png"
        echo "✔ Đã xóa phiên đăng nhập Zalo. Để đăng nhập tài khoản khác: $CMD_NAME login-zalo"
        ;;
    doctor|check|heal|repair)
        shift
        "$PROJECT_DIR/doctor.sh" "$@"
        ;;
    help|--help|-h)
        echo "🐷 HEO-AGENT (BÉ HEO) — BỘ LỆNH ĐIỀU HÀNH TOÀN HỆ THỐNG:"
        echo ""
        echo " 🚀 1. CÁC LỆNH KHỞI ĐỘNG HỆ THỐNG:"
        echo "   👉 $CMD_NAME               : Khởi chạy hệ thống & tự động mở Web Dashboard (http://localhost:5066)"
        echo "   👉 $CMD_NAME --bg          : Khởi chạy chế độ nền (Daemon 24/7 trực chiến ngầm)"
        echo "   👉 $CMD_NAME tui           : Mở lại Trình cấu hình Terminal & Quét mã QR Zalo"
        echo "   👉 $CMD_NAME web           : Khởi chạy riêng và mở Bảng điều khiển Web Console (cổng 5066)"
        echo ""
        echo " ⚙️ 2. CÁC LỆNH THÔNG DỤNG HÀNG NGÀY:"
        echo "   👉 $CMD_NAME status        : Kiểm tra trạng thái hoạt động (Zalo, Quota AI, Bot)"
        echo "   👉 $CMD_NAME doctor        : Chẩn đoán sức khỏe hệ thống toàn diện (10 tiêu chuẩn)"
        echo "   👉 $CMD_NAME doctor --fix  : Tự động sửa chữa & phục hồi khi gặp sự cố (1-Click)"
        echo "   👉 $CMD_NAME logs          : Xem luồng nhật ký hoạt động thời gian thực"
        echo "   👉 $CMD_NAME model         : Xem & chuyển đổi mô hình AI (flash, pro, sonnet, opus)"
        echo "   👉 $CMD_NAME effort        : Điều chỉnh mức suy luận logic (low, medium, high)"
        echo "   👉 $CMD_NAME login-zalo    : Quét mã QR đăng nhập tài khoản Zalo mới"
        echo "   👉 $CMD_NAME logout-zalo   : Đăng xuất tài khoản Zalo hiện tại"
        echo "   👉 $CMD_NAME login-google  : Đăng nhập Google OAuth (mở trang tự chọn tài khoản)"
        echo "   👉 $CMD_NAME sync-google   : Đồng bộ nhanh tài khoản Google có sẵn từ máy chủ"
        echo "   👉 $CMD_NAME logout-google : Đăng xuất tài khoản Google của AGY CLI"
        echo "   👉 $CMD_NAME update        : Cập nhật Heo-Agent lên phiên bản mới nhất ngay lập tức"
        echo "   👉 $CMD_NAME restart       : Khởi động lại toàn bộ dịch vụ Heo-Agent"
        echo "   👉 $CMD_NAME stop          : Dừng toàn bộ hệ thống an toàn"
        echo "   👉 $CMD_NAME uninstall     : Dọn dẹp sạch sẽ & khôi phục cài đặt gốc (Factory Reset)"
        echo ""
        echo "   💡 Tự động cập nhật: Heo-Agent tự pull code mới mỗi 1 giờ trong nền."
        ;;
    uninstall|clean)
        shift
        "$PROJECT_DIR/uninstall.sh" "$@"
        ;;
    *)
        # Mặc định khi gọi lệnh heo-agent / heo-zalo không tham số:
        # Nếu chưa chạy thì tự động khởi chạy daemon; nếu đang chạy thì báo trạng thái và luôn luôn tự mở Web UI
        if curl -s -m 1 http://127.0.0.1:5066/api/status >/dev/null 2>&1; then
            echo "🚀 Heo-Agent (Bé Heo) đang trực chiến 24/7!"
            echo "🌐 Đang tự động mở Web Dashboard tại: http://localhost:5066"
            open_web_ui
            curl -s http://127.0.0.1:5066/api/status | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    cmd = sys.argv[1] if len(sys.argv)>1 else 'heo-agent'
    print('\n🔹 Mô hình AI:', d.get('active_model'))
    print('🔹 Mức suy luận (Effort):', str(d.get('effort', 'medium')).upper())
    print('🔹 Tài khoản Zalo:', 'Đã kết nối (UID: ' + str(d.get('zalo', {}).get('user_id', 'N/A')) + ')' if d.get('zalo', {}).get('logged_in') else 'Chưa đăng nhập')
    print('🔹 Google AGY Auth:', 'Đã xác thực' if d.get('google', {}).get('authenticated') else 'Chưa xác thực')
    print('🔹 Sếp nhận diện:', d.get('config', {}).get('boss_name', 'Sếp'))
    print('\n💡 Tiện ích nhanh:')
    print(f'   • {cmd} doctor  : Chẩn đoán & tự động sửa chữa phục hồi khi bị lỗi')
    print(f'   • {cmd} logs    : Xem luồng log thời gian thực')
    print(f'   • {cmd} model   : Xem và đổi mô hình AI')
    print(f'   • {cmd} restart : Khởi động lại hệ thống')
    print(f'   • {cmd} stop    : Dừng hệ thống')
except Exception:
    pass
" "$CMD_NAME"
        else
            echo "🚀 Khởi chạy Heo-Agent (Bé Heo)..."
            "$PROJECT_DIR/start.sh" daemon
        fi
        ;;
esac
